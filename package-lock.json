{
  "name": "syndroo-web",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "syndroo-web",
      "version": "0.0.0",
      "license": "Apache-2.0",
      "workspaces": [
        "apps/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "apps/docs": {
      "name": "@syndroo/docs",
      "version": "0.0.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=24"
      }
    },
    "apps/website": {
      "name": "@syndroo/website",
      "version": "0.0.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@syndroo/docs": {
      "resolved": "apps/docs",
      "link": true
    },
    "node_modules/@syndroo/website": {
      "resolved": "apps/website",
      "link": true
    }
  }
}
