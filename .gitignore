# Dependencies
node_modules/

# Build output: regenerate with `npm run build`
apps/*/dist/
apps/*/out/
apps/*/.next/

# Static assets are copied from packages/brand/assets by `npm run assets`
apps/*/public/assets/

# Editor and OS noise
.DS_Store
*.log

# Local environment and secret files. Copy `.env.example` instead of committing
# a real one; the example is the only environment file that belongs in git.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Next.js TypeScript incremental build info
*.tsbuildinfo
